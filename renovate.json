{
  "extends": [
    "github>nuxt/renovate-config-nuxt"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [{
    "matchDepTypes": ["resolutions"],
    "enabled": false
  }, {
    "matchPackageNames": ["vue-tsc"],
    "allowedVersions": "!/^3\\.3\\.1[234]$/"
  }],
  "postUpdateOptions": ["pnpmDedupe"]
}
